        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres_ec2_ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  time,\r\n  CONCAT(\r\n    '[', \r\n    CASE \r\n      WHEN message ILIKE '%success%' THEN 'INFO' \r\n      ELSE 'ERROR' \r\n    END, \r\n    '] ',\r\n    'user=', tl.metadata->>'username', ' ',\r\n    'action=', tl.metadata->>'actionType', ' ',\r\n    'url=', tl.metadata->>'url', ' ',\r\n    'message=\"', message, '\"'\r\n  ) AS message,\r\n  CASE \r\n    WHEN message ILIKE '%success%' THEN 'INFO' \r\n    ELSE 'ERROR' \r\n  END AS level,\r\n  tl.metadata->>'username' AS username,\r\n  rs_id,\r\n  tl.metadata->>'actionType' AS action_type,\r\n  tl.metadata->>'url' AS url,\r\n  message AS description\r\nFROM transaction_logs tl\r\nWHERE\r\n  $__timeFilter(time) \r\nORDER BY time DESC;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
